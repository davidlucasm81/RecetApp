<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    tools:context=".fragments.ListaCompraFragment">

    <LinearLayout
        android:id="@+id/titleLL"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:baselineAligned="false"
        tools:ignore="RtlSymmetry">

        <TextView
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:padding="4dp"
            android:text="@string/lista_compra"
            android:textSize="20sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center|end"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <ImageButton
                android:id="@+id/btnCopiar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/boton_redondo"
                android:src="@drawable/ic_baseline_content_copy_24"
                android:scaleType="centerInside"
                android:padding="6dp"
                android:contentDescription="@string/copiar_lista_compra"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/btnCortar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/boton_redondo"
                android:src="@drawable/ic_baseline_content_cut_24"
                android:scaleType="centerInside"
                android:padding="6dp"
                android:contentDescription="@string/cortar_lista_compra"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/btnCompartir"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/boton_redondo"
                android:src="@drawable/ic_baseline_share_24"
                android:scaleType="centerInside"
                android:padding="6dp"
                android:contentDescription="@string/compartir_lista_compra"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/btnBorrar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:layout_marginEnd="4dp"
                android:background="@drawable/boton_redondo"
                android:src="@drawable/ic_baseline_delete_24"
                android:scaleType="centerInside"
                android:padding="6dp"
                android:contentDescription="@string/borrar_lista_compra"
                tools:ignore="SpeakableTextPresentCheck" />

            <ImageButton
                android:id="@+id/btnActualizar"
                android:layout_width="34dp"
                android:layout_height="34dp"
                android:background="@drawable/boton_redondo"
                android:src="@drawable/baseline_shopping_cart_24"
                android:scaleType="centerInside"
                android:padding="6dp"
                android:contentDescription="@string/actualizar_recetas"
                tools:ignore="SpeakableTextPresentCheck" />
        </LinearLayout>

    </LinearLayout>

    <EditText
        android:id="@+id/editText"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:gravity="top|start"
        android:hint="@string/lista_compra"
        android:importantForAutofill="no"
        android:inputType="textMultiLine"
        tools:ignore="VisualLintTextFieldSize,DuplicateSpeakableTextCheck" />

</LinearLayout>

